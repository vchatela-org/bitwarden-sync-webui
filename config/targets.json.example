{
  "_comment": "Rename this file to targets.json and fill in your real values.",

  "vaults": [
    { "key": "eu", "name": "Bitwarden EU", "serverUrl": "https://vault.bitwarden.eu" },
    { "key": "com", "name": "Bitwarden US", "serverUrl": "https://vault.bitwarden.com" },
    { "key": "selfhosted", "name": "Self-hosted", "serverUrl": "https://bitwarden.example.internal" }
  ],

  "backupFolder": "/backups",
  "bitwardenConfigDir": "/data",

  "users": [
    {
      "key": "alice",
      "email": "alice@example.com",
      "displayName": "Alice",
      "from": "eu",
      "to": "com"
    },
    {
      "key": "bob",
      "email": "bob@example.com",
      "from": "com",
      "to": "selfhosted"
    }
  ],

  "orgs": [
    {
      "key": "acme",
      "name": "Acme Corp",
      "owner": "bob",
      "from": "com",
      "to": "selfhosted",
      "orgIds": {
        "com": "00000000-0000-0000-0000-000000000001",
        "selfhosted": "00000000-0000-0000-0000-000000000002"
      }
    }
  ],

  "retention": {
    "keepDaily": 7,
    "keepMonthly": 12
  },

  "importGuard": {
    "minSourceRatio": 0.5,
    "blockOnEmptySource": true
  },

  "homeLogoutAfterImport": true
}
