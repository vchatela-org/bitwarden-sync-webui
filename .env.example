# ─── Required ─────────────────────────────────────────────────────────────────

# Plain-text password for the web UI login page (dev only).
# For production, generate a hash instead and use UI_PASSWORD_HASH:
#   node -e "import('argon2').then(a=>a.hash('yourpassword')).then(console.log)"
UI_PASSWORD=changeme

# Long random secret used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_48_chars

# Path to your targets JSON config file (see config/targets.json.example).
CONFIG_PATH=./config/targets.json

# ─── Optional ──────────────────────────────────────────────────────────────────

# Argon2id hash of the UI password. When set, UI_PASSWORD is ignored.
# Generate from webui/server/: node -e "import('argon2').then(a=>a.hash('pw')).then(console.log)"
# IMPORTANT: escape every '$' as '$$' — Docker Compose interpolates bare '$' as variables.
# UI_PASSWORD_HASH=$$argon2id$$v=19$$m=65536,t=3,p=4$$...

# TCP port the backend server listens on (default: 3000).
# PORT=3000

# Directory where backup archives are written (default: /backups in Docker).
# BACKUP_FOLDER=/backups

# Directory where Bitwarden CLI profile data is stored (default: /data in Docker).
# BW_CONFIG_DIR=/data

# Override the bw CLI binary path (default: bw).
# BW_BIN=bw

# Set to the exact pinned bw CLI version to enforce at startup.
# BW_CLI_PINNED_VERSION=2025.12.0

# Directory where password FIFOs are created (Linux only, default: /run/bw-fifo).
# BW_FIFO_DIR=/run/bw-fifo

# How long (ms) a stored master password lives in RAM before being wiped (default: 900000 = 15 min).
# PASSWORD_TTL_MS=900000

# Set to 1 if the app is behind a reverse proxy that sets X-Forwarded-Proto.
# TRUST_PROXY=0
